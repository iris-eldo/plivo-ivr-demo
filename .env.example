# Copy this file to .env and fill in real values. Never commit .env itself.

# From the assignment PDF / your Plivo console
PLIVO_AUTH_ID=your_auth_id_here
PLIVO_AUTH_TOKEN=your_auth_token_here

# The Plivo number provided for this assignment (caller ID for the outbound call)
PLIVO_FROM_NUMBER=+918035454161

# Your own phone number that will receive the call, E.164 format e.g. +9198XXXXXXXX
TARGET_PHONE_NUMBER=+91XXXXXXXXXX

# Public HTTPS base URL for this app while testing (your current ngrok forwarding URL)
# e.g. https://abcd1234.ngrok-free.app  -- NO trailing slash
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# OTP = your birthdate in DDMM format, e.g. March 15 -> 1503
OTP_CODE=0000

# Placeholder "live associate" number from the assignment PDF
ASSOCIATE_NUMBER=02264236412
